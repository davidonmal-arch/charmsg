rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.uid == 'admin_farnaz'
        && request.auth.token.get('admin', false) == true;
    }

    function active() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', true) == false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || active() || admin());
      allow update: if admin();
      allow delete: if admin() && uid != 'admin_farnaz';

      match /preferences/seen {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if active() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['chats'])
          && request.resource.data.chats is map
          && request.resource.data.chats.size() <= 500;
      }
    }

    match /chats/{chatId} {
      allow read: if admin();
      match /messages/{messageId} {
        allow read, delete: if admin();
      }
    }

    match /community/event {
      allow read: if active();
    }

    match /market/{docId} {
      allow read: if active();
      allow write: if admin();
    }

    match /nfts/{docId} {
      allow read: if active();
    }

    match /trades/{docId} {
      allow read: if active();
    }

    match /casino/{docId} {
      allow read: if active();
    }
  }
}
